# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# NEXT_PUBLIC_SITE_URL: Optional canonical production domain (e.g. https://cleylawyerlegal.com)
NEXT_PUBLIC_SITE_URL=""

# GOOGLE_SITE_VERIFICATION: Verification token provided by Google Search Console (meta tag)
GOOGLE_SITE_VERIFICATION=""

# BING_SITE_VERIFICATION: Verification code provided by Bing Webmaster Tools (meta tag msvalidate.01 and /BingSiteAuth.xml)
BING_SITE_VERIFICATION=""

# NEXT_PUBLIC_GA_MEASUREMENT_ID: Real Google Analytics 4 measurement ID (format G-XXXXXXXXXX)
# Only activated after explicit user consent.
NEXT_PUBLIC_GA_MEASUREMENT_ID=""

# NEXT_PUBLIC_GTM_ID: Optional Google Tag Manager container ID (format GTM-XXXXXXX)
# Only activated after explicit user consent.
NEXT_PUBLIC_GTM_ID=""

# NEXT_PUBLIC_CLARITY_ID: Optional Microsoft Clarity project ID
# Only activated after explicit user consent; sensitive form fields remain masked.
NEXT_PUBLIC_CLARITY_ID=""

# BLOCK_GPTBOT_TRAINING: Optional "true" to disallow GPTBot model training while keeping OAI-SearchBot allowed
BLOCK_GPTBOT_TRAINING=""

# INDEXNOW_KEY: Optional 8-128 char alphanumeric/hyphen key for Bing IndexNow (/KEY.txt verification)
INDEXNOW_KEY=""

# INDEXNOW_ADMIN_SECRET: Required Bearer token to authorize POST /api/indexnow submissions
INDEXNOW_ADMIN_SECRET=""
